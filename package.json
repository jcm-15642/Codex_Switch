{
  "name": "codex-switch",
  "displayName": "Codex Switch",
  "description": "Manage and safely switch Codex API URL and API key profiles.",
  "version": "0.2.0",
  "publisher": "codex-switch",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/jcm-15642/Codex_Switch.git"
  },
  "bugs": {
    "url": "https://github.com/jcm-15642/Codex_Switch/issues"
  },
  "homepage": "https://github.com/jcm-15642/Codex_Switch#readme",
  "keywords": ["codex", "vscode", "wsl", "api", "profile"],
  "engines": { "vscode": "^1.95.0" },
  "categories": ["Other"],
  "activationEvents": [
    "onView:codexSwitch.profiles",
    "onCommand:codexSwitch.switchProfile"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "configuration": {
      "title": "Codex Switch",
      "properties": {
        "codexSwitch.wslDistribution": {
          "type": "string",
          "default": "",
          "description": "WSL distribution to use from a local Windows VS Code window. Leave empty to use the default distribution."
        },
        "codexSwitch.backupRetentionCount": {
          "type": "number",
          "default": 10,
          "minimum": 3,
          "description": "Number of complete Codex configuration backup groups to retain. At least the newest three are always kept."
        },
        "codexSwitch.backupMaxAgeDays": {
          "type": "number",
          "default": 30,
          "minimum": 0,
          "description": "Delete backup groups older than this many days after a successful write. Set to 0 to disable age-based cleanup."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "codexSwitch",
          "title": "Codex Switch",
          "icon": "media/codex-switch.svg"
        }
      ]
    },
    "views": {
      "codexSwitch": [
        {
          "id": "codexSwitch.profiles",
          "name": "API Profiles"
        }
      ]
    },
    "commands": [
      { "command": "codexSwitch.switchProfile", "title": "Codex Switch: Switch Profile" },
      { "command": "codexSwitch.addProfile", "title": "Codex Switch: Add Profile" },
      { "command": "codexSwitch.captureOfficialProfile", "title": "Codex Switch: Import Current Official Account" },
      { "command": "codexSwitch.renameProfile", "title": "Codex Switch: Rename Profile", "icon": "$(edit)" },
      { "command": "codexSwitch.editProfile", "title": "Codex Switch: Edit Profile" },
      { "command": "codexSwitch.deleteProfile", "title": "Codex Switch: Delete Profile" },
      { "command": "codexSwitch.manageBackups", "title": "Codex Switch: Manage Backups", "icon": "$(archive)" },
      { "command": "codexSwitch.cleanBackups", "title": "Codex Switch: Clean Managed Backups" },
      { "command": "codexSwitch.cleanLegacyBackups", "title": "Codex Switch: Remove Legacy Backup Files" },
      { "command": "codexSwitch.refreshProfiles", "title": "Codex Switch: Refresh Profiles", "icon": "$(refresh)" },
      { "command": "codexSwitch.importCurrentConfig", "title": "Codex Switch: Import Current Codex Configuration" },
      { "command": "codexSwitch.selectWslDistribution", "title": "Codex Switch: Select WSL Distribution" }
    ],
    "menus": {
      "view/title": [
        { "command": "codexSwitch.addProfile", "when": "view == codexSwitch.profiles", "group": "navigation@1" },
        { "command": "codexSwitch.captureOfficialProfile", "when": "view == codexSwitch.profiles", "group": "navigation@2" },
        { "command": "codexSwitch.refreshProfiles", "when": "view == codexSwitch.profiles", "group": "navigation@3" },
        { "command": "codexSwitch.manageBackups", "when": "view == codexSwitch.profiles", "group": "navigation@4" }
      ],
      "view/item/context": [
        { "command": "codexSwitch.switchProfile", "when": "view == codexSwitch.profiles && viewItem == codexProfile", "group": "inline@1" },
        { "command": "codexSwitch.renameProfile", "when": "view == codexSwitch.profiles && viewItem == codexProfile", "group": "inline@2" },
        { "command": "codexSwitch.editProfile", "when": "view == codexSwitch.profiles && viewItem == codexProfile", "group": "inline@3" },
        { "command": "codexSwitch.deleteProfile", "when": "view == codexSwitch.profiles && viewItem == codexProfile", "group": "inline@4" }
      ],
      "commandPalette": [
        { "command": "codexSwitch.renameProfile", "when": "false" },
        { "command": "codexSwitch.editProfile", "when": "false" },
        { "command": "codexSwitch.deleteProfile", "when": "false" }
      ]
    }
  },
  "scripts": {
    "compile": "tsc -p .",
    "watch": "tsc -watch -p .",
    "test": "npm run compile && node --test out/test/*.test.js",
    "package": "npm run compile && vsce package --allow-missing-repository",
    "release:check": "npm test && npm run package"
  },
  "dependencies": {
    "@iarna/toml": "^2.2.5"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "@types/vscode": "^1.95.0",
    "@vscode/vsce": "^3.2.1",
    "typescript": "^5.7.2"
  }
}
